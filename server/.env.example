# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origin (used by CORS middleware)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or Local Instance)
# Example Local: mongodb://127.0.0.1:27017/portfolio_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio_db?retryWrites=true&w=majority
MONGODB_URI=
